<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20261107" />
  </ItemGroup>

  <ItemGroup>
    <!-- Haar Cascade modeli derleme çıktısındaki models/ klasörüne kopyalanır; böylece
         uygulama proje klasörüne bağlı kalmadan (ör. bin klasöründen veya publish sonrası) çalışır. -->
    <None Update="Models\haarcascade_frontalface_default.xml">
      <Link>models\haarcascade_frontalface_default.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>